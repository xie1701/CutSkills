{
 "cues": [
  {
   "start": 0.06,
   "end": 3.0,
   "text": "事情不是这么简单的"
  },
  {
   "start": 3.0,
   "end": 5.76,
   "text": "去非黑即白，"
  },
  {
   "start": 5.76,
   "end": 6.72,
   "text": "我是这样看的。"
  },
  {
   "start": 6.853,
   "end": 9.553,
   "text": "进口的一定好就对吧"
  },
  {
   "start": 9.566,
   "end": 11.726,
   "text": "他就觉得差不多，"
  },
  {
   "start": 11.726,
   "end": 13.106,
   "text": "或者说觉得国产的也"
  },
  {
   "start": 13.106,
   "end": 14.466,
   "text": "不错。"
  },
  {
   "start": 14.586,
   "end": 16.733,
   "text": "都有偏颇嗯"
  },
  {
   "start": 16.733,
   "end": 18.653,
   "text": "因为我们毕竟第一我"
  },
  {
   "start": 18.653,
   "end": 21.713,
   "text": "们门店来说一直是在"
  },
  {
   "start": 21.713,
   "end": 22.772,
   "text": "做进口涂料"
  },
  {
   "start": 22.832,
   "end": 24.29,
   "text": "也做了相当"
  },
  {
   "start": 24.29,
   "end": 26.27,
   "text": "一部分的商业项目，"
  },
  {
   "start": 26.27,
   "end": 27.23,
   "text": "就是在珠海，"
  },
  {
   "start": 27.317,
   "end": 30.617,
   "text": "包括房地产的售楼部"
  },
  {
   "start": 30.617,
   "end": 34.231,
   "text": "知名的餐厅酒店民宿"
  },
  {
   "start": 34.291,
   "end": 36.211,
   "text": "不管珠海的广州的现"
  },
  {
   "start": 36.211,
   "end": 38.191,
   "text": "在广州在做的上海的"
  },
  {
   "start": 38.191,
   "end": 39.811,
   "text": "厦门的汕"
  },
  {
   "start": 39.837,
   "end": 41.577,
   "text": "那么因为有不同的需"
  },
  {
   "start": 41.577,
   "end": 43.437,
   "text": "求，就是说我们也不"
  },
  {
   "start": 43.437,
   "end": 45.237,
   "text": "能说是只是只拿进口"
  },
  {
   "start": 45.237,
   "end": 46.557,
   "text": "产品，因为毕竟进口"
  },
  {
   "start": 46.557,
   "end": 47.937,
   "text": "的产品它的成本比较"
  },
  {
   "start": 47.937,
   "end": 48.657,
   "text": "高。"
  },
  {
   "start": 48.764,
   "end": 50.984,
   "text": "给他打了大概有不下"
  },
  {
   "start": 50.984,
   "end": 52.184,
   "text": "10个样板，"
  },
  {
   "start": 52.184,
   "end": 56.564,
   "text": "其中有三个国产厂家"
  },
  {
   "start": 56.571,
   "end": 59.991,
   "text": "然后也打了进口的，"
  },
  {
   "start": 59.991,
   "end": 63.651,
   "text": "最后业主方怎么都觉"
  },
  {
   "start": 63.651,
   "end": 64.911,
   "text": "得的进口的好，"
  },
  {
   "start": 64.938,
   "end": 68.358,
   "text": "虽然实事求是的讲原"
  },
  {
   "start": 68.358,
   "end": 70.818,
   "text": "料成本可能差到4倍"
  },
  {
   "start": 70.818,
   "end": 72.078,
   "text": "四到5倍。"
  },
  {
   "start": 72.155,
   "end": 74.135,
   "text": "不同的产品，"
  },
  {
   "start": 74.135,
   "end": 75.995,
   "text": "它该有它该去的地方"
  },
  {
   "start": 75.995,
   "end": 79.352,
   "text": "，该有它该有的位置"
  }
 ],
