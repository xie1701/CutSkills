{
 "cues": [
  {
   "start": 0.06,
   "end": 3.0,
   "text": "事情不是这么简单的"
  },
  {
   "start": 3.0,
   "end": 5.76,
   "text": "去非黑即白，"
  },
  {
   "start": 5.76,
   "end": 6.72,
   "text": "我是这样看的。"
  },
  {
   "start": 6.853,
   "end": 9.553,
   "text": "进口的一定好就对吧"
  },
  {
   "start": 9.566,
   "end": 11.726,
   "text": "他就觉得差不多，"
  },
  {
   "start": 11.726,
   "end": 13.106,
   "text": "或者说觉得国产的也"
  },
  {
   "start": 13.106,
   "end": 14.446,
   "text": "不错。"
  },
  {
   "start": 14.566,
   "end": 16.686,
   "text": "都有偏颇嗯"
  },
  {
   "start": 16.686,
   "end": 18.606,
   "text": "因为我们毕竟第一我"
  },
  {
   "start": 18.606,
   "end": 21.666,
   "text": "们门店来说一直是在"
  },
  {
   "start": 21.666,
   "end": 22.719,
   "text": "做进口涂料"
  },
  {
   "start": 22.779,
   "end": 24.219,
   "text": "也做了相当"
  },
  {
   "start": 24.219,
   "end": 26.199,
   "text": "一部分的商业项目，"
  },
  {
   "start": 26.199,
   "end": 27.159,
   "text": "就是在珠海，"
  },
  {
   "start": 27.219,
   "end": 30.519,
   "text": "包括房地产的售楼部"
  },
  {
   "start": 30.519,
   "end": 34.126,
   "text": "知名的餐厅酒店民宿"
  },
  {
   "start": 34.186,
   "end": 36.106,
   "text": "不管珠海的广州的现"
  },
  {
   "start": 36.106,
   "end": 38.086,
   "text": "在广州在做的上海的"
  },
  {
   "start": 38.086,
   "end": 39.706,
   "text": "厦门的汕"
  },
  {
   "start": 39.706,
   "end": 41.446,
   "text": "那么因为有不同的需"
  },
  {
   "start": 41.446,
   "end": 43.306,
   "text": "求，就是说我们也不"
  },
  {
   "start": 43.306,
   "end": 45.106,
   "text": "能说是只是只拿进口"
  },
  {
   "start": 45.106,
   "end": 46.426,
   "text": "产品，因为毕竟进口"
  },
  {
   "start": 46.426,
   "end": 47.806,
   "text": "的产品它的成本比较"
  },
  {
   "start": 47.806,
   "end": 48.526,
   "text": "高。"
  },
  {
   "start": 48.599,
   "end": 50.819,
   "text": "给他打了大概有不下"
  },
  {
   "start": 50.819,
   "end": 52.019,
   "text": "10个样板，"
  },
  {
   "start": 52.019,
   "end": 56.399,
   "text": "其中有三个国产厂家"
  },
  {
   "start": 56.406,
   "end": 59.826,
   "text": "然后也打了进口的，"
  },
  {
   "start": 59.826,
   "end": 63.486,
   "text": "最后业主方怎么都觉"
  },
  {
   "start": 63.486,
   "end": 64.746,
   "text": "得的进口的好，"
  },
  {
   "start": 64.746,
   "end": 68.166,
   "text": "虽然实事求是的讲原"
  },
  {
   "start": 68.166,
   "end": 70.626,
   "text": "料成本可能差到4倍"
  },
  {
   "start": 70.626,
   "end": 71.886,
   "text": "四到5倍。"
  },
  {
   "start": 71.946,
   "end": 73.926,
   "text": "不同的产品，"
  },
  {
   "start": 73.926,
   "end": 75.786,
   "text": "它该有它该去的地方"
  },
  {
   "start": 75.786,
   "end": 79.153,
   "text": "，该有它该有的位置"
  }
 ],
